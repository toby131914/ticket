{
  "manifest_version": 3,
  "name": "Google Forms Sniper",
  "version": "1.2",
  "description": "Open and fill Google Forms with high precision timing.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.github.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Google Forms Sniper",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://*.github.io/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
