{
  "manifest_version": 3,
  "name": "搶票助手",
  "version": "1.1",
  "description": "Google Forms 自動搶票填寫工具",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.github.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "externally_connectable": {
    "matches": [
      "https://*.github.io/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}